# ============================================================
# PneumoVision AI — Environment Template
# Rename this file to .env and fill in your values
# ============================================================

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pneumovision?retryWrites=true&w=majority
MONGODB_DB_NAME=pneumovision

# JWT Security
SECRET_KEY=generate_with_python_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# FastAPI App Configuration
APP_NAME=PneumoVision AI
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# TensorFlow Model Settings
MODEL_PATH=../pneumovision_vgg16_final.keras
MODEL_VERSION=VGG16 Fine-Tuned v1.0
IMAGE_SIZE=224

# Upload Limits & File Storage
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
HEATMAP_DIR=heatmaps
REPORT_DIR=reports
